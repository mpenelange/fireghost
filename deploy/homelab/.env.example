# EDIT these three values to match your existing Traefik installation.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Direct LAN/Tailscale peers only. Adjust to actual trusted client subnets.
# Do not add a tunnel/proxy subnet without reviewing forwarded-client IP trust.
ALLOWED_CIDRS=192.168.0.0/16,10.0.0.0/8,100.64.0.0/10

# Set your service credential locally, NOT your Firecrawl Cloud key.
ROUTER_API_KEY=REPLACE_WITH_RANDOM_SECRET
CRW_IMAGE=git.firewire.cc/michael/hermes-web-retrieval-crw@sha256:b77d189b56546d6e90f4a577b1b7b65f10bba42989ab4d79a5b63c2c6cda01a5

# Cloud fallback intentionally disabled for safe parallel migration testing.
FIRECRAWL_CLOUD_API_KEY=
ROUTER_DAILY_CLOUD_CREDITS=0
ROUTER_CLOUD_BURST_CREDITS=0
ROUTER_CLOUD_REFILL_CREDITS_PER_DAY=0
ROUTER_MONTHLY_CLOUD_CREDITS=0
ROUTER_MONTHLY_RESET_DAY=3
ROUTER_HTTP_TIMEOUT=90s

# Maximum concurrent distinct retrieval operations; positive integer.
# Excess operations wait; duplicate requests share work; cache hits bypass it.
ROUTER_MAX_INFLIGHT=64
